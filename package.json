{
  "name": "tasks-app",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "bun run --filter './apps/*' build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "dev:api": "bun run --filter @tasks/api dev",
    "dev:web": "bun run --filter @tasks/web dev",
    "lint": "biome lint .",
    "test": "bun run --filter './apps/*' test",
    "typecheck": "bun run --filter './apps/*' typecheck",
    "validate": "bun run check && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
